# Local values for every environment key (src/env.ts). Copy to .env, which is never committed.
# ENVIRONMENT has no default: a process without it fails at boot. Outside local, every key marked
# "required outside local" has no default either.
ENVIRONMENT=local
PORT=3000
LOG_LEVEL=debug
# Longest one readiness check may take, in ms.
READINESS_TIMEOUT_MS=2000
# Longest shutdown waits for in-flight requests before closing them, in ms.
SHUTDOWN_TIMEOUT_MS=10000
# How long /readyz answers 503 before the server stops accepting, in ms. 0 locally.
SHUTDOWN_GRACE_MS=0
# Largest request body accepted, in bytes (1 MB).
MAX_REQUEST_BODY_BYTES=1048576

# The Region this deployment serves (us or eu). Required outside local.
REGION=us
# Sentry project of this Region (never share one between Regions). Required outside local; unset
# locally sends nothing.
# SENTRY_DSN=
# GIT_SHA=

# Postgres login of this service (closeline_playbook), from the compose file in this repo.
# Required outside local. Carries a password: never log it.
DATABASE_URL=postgres://closeline_playbook:closeline_playbook_local@127.0.0.1:5432/closeline
# Where the auth service publishes its signing keys, and the iss and aud its tokens carry.
# Required outside local.
AUTH_JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json
AUTH_ISSUER=http://127.0.0.1:3001
AUTH_AUDIENCE=closeline

# The AWS Region of the queue and the bucket. Required outside local.
AWS_REGION=us-east-1
# Unset, the queue and the object store live in this process's memory (local only). Set both to
# run against ElasticMQ and S3Mock from the hub's dev stack; the endpoints are accepted only
# when ENVIRONMENT is local. Required outside local.
# QUEUE_URL=http://127.0.0.1:9324/000000000000/playbook
# QUEUE_ENDPOINT=http://127.0.0.1:9324
# STORAGE_BUCKET=closeline-dev
# STORAGE_ENDPOINT=http://127.0.0.1:9090

# Upload limits. The defaults are the contract's (25 MiB, 300 pages); these may lower them, never
# raise them.
# MAX_UPLOAD_BYTES=26214400
# MAX_PAGES_PER_DOCUMENT=300
# Uploads one instance handles at once. Each is held whole in memory, so this times
# MAX_UPLOAD_BYTES is the memory uploads may need (1 to 16).
MAX_CONCURRENT_UPLOADS=4
# The longest an upload body may take to arrive, in ms (100 to 600000); a slower one is cut off.
# UPLOAD_BODY_TIMEOUT_MS=60000

# Quotas per Organization, soft-deleted documents included until purged (ADR 0016).
# MAX_DOCUMENTS_PER_ORGANIZATION=500
# MAX_BYTES_PER_ORGANIZATION=2147483648

# Secrets the callers of /internal routes may present as a bearer token, comma separated: two is a
# rotation (ADR 0013). Each is 32 to 512 characters. Required outside local, where the public local
# default is used when this is unset and is refused everywhere else.
# INTERNAL_API_TOKENS=

# Queue messages handled at once by one instance (1 to 100).
CONSUMER_CONCURRENCY=4
# How long shutdown lets in-flight messages finish before giving them back, in ms. At most
# SHUTDOWN_TIMEOUT_MS.
CONSUMER_STOP_DEADLINE_MS=5000
