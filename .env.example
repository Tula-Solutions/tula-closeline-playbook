# Local values for every environment key (src/env.ts). Copy to .env, which is never committed.
# ENVIRONMENT has no default: a process without it fails at boot. Outside local, every key marked
# "required outside local" has no default either.
ENVIRONMENT=local
PORT=3000
LOG_LEVEL=debug
# Longest one readiness check may take, in ms.
READINESS_TIMEOUT_MS=2000
# Longest shutdown waits for in-flight requests before closing them, in ms.
SHUTDOWN_TIMEOUT_MS=10000
# How long /readyz answers 503 before the server stops accepting, in ms. 0 locally.
SHUTDOWN_GRACE_MS=0
# Largest request body accepted, in bytes (1 MB).
MAX_REQUEST_BODY_BYTES=1048576

# The Region this deployment serves (us or eu). Required outside local.
REGION=us
# Sentry project of this Region (never share one between Regions). Required outside local; unset
# locally sends nothing.
# SENTRY_DSN=
# GIT_SHA=

# Postgres login of this service (closeline_playbook), from the compose file in this repo.
# Required outside local. Carries a password: never log it.
DATABASE_URL=postgres://closeline_playbook:closeline_playbook_local@127.0.0.1:5432/closeline
# Where the auth service publishes its signing keys, and the iss and aud its tokens carry.
# Required outside local.
AUTH_JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json
AUTH_ISSUER=http://127.0.0.1:3001
AUTH_AUDIENCE=closeline

# The AWS Region of the queue and the bucket. Required outside local.
AWS_REGION=us-east-1
# Unset, the queue and the object store live in this process's memory (local only). Set both to
# run against ElasticMQ and S3Mock from the hub's dev stack; the endpoints are accepted only
# when ENVIRONMENT is local. Required outside local.
# QUEUE_URL=http://127.0.0.1:9324/000000000000/playbook
# QUEUE_ENDPOINT=http://127.0.0.1:9324
# STORAGE_BUCKET=closeline-dev
# STORAGE_ENDPOINT=http://127.0.0.1:9090

# Upload limits. The defaults are the contract's (25 MiB, 300 pages); these may lower them, never
# raise them.
# MAX_UPLOAD_BYTES=26214400
# MAX_PAGES_PER_DOCUMENT=300
# Uploads one instance handles at once. Each is held whole in memory, so this times
# MAX_UPLOAD_BYTES is the memory uploads may need (1 to 16).
MAX_CONCURRENT_UPLOADS=4
# The longest an upload body may take to arrive, in ms (100 to 600000); a slower one is cut off.
# UPLOAD_BODY_TIMEOUT_MS=60000
# The longest a Recording upload body (streamed, up to 500 MB) may take to arrive, in ms (1000 to 7200000).
# RECORDING_BODY_TIMEOUT_MS=1800000
# The least a Recording upload must send, in bytes a second, over each window below (1 to 100000000).
# RECORDING_MIN_BYTES_PER_SECOND=32768
# The window that minimum rate is judged over, in ms (100 to 600000).
# RECORDING_RATE_WINDOW_MS=60000

# Quotas per Organization, soft-deleted documents included until purged (ADR 0016).
# MAX_DOCUMENTS_PER_ORGANIZATION=500
# MAX_BYTES_PER_ORGANIZATION=2147483648

# The rights confirmation wording version is not a setting: it is the contract's
# CURRENT_RIGHTS_WORDING_VERSION, and a wording change is a contract release.
# Deals an Organization may hold; a Deal import stops creating Deals here (default: the contract's quota).
# MAX_DEALS_PER_ORGANIZATION=20000
# Whether this instance runs Deal import jobs. Independent of WORKERS_ENABLED (an import uses no
# embedder, OCR or vector store); imports share the INGESTION_CONCURRENCY pool.
# IMPORTS_ENABLED=true

# Secrets the callers of /internal routes may present as a bearer token, comma separated: two is a
# rotation (ADR 0013). Each is 32 to 512 characters. Required outside local, where the public local
# default is used when this is unset and is refused everywhere else.
# INTERNAL_API_TOKENS=

# Queue messages handled at once by one instance (1 to 100).
CONSUMER_CONCURRENCY=4
# How long shutdown lets in-flight messages finish before giving them back, in ms. At most
# SHUTDOWN_TIMEOUT_MS.
CONSUMER_STOP_DEADLINE_MS=5000

# Ingestion job loop (hub issue 14, round B). WORKERS_ENABLED=false makes an API-only instance.
# Default: true in local, false elsewhere; true is refused outside local until the pipeline ports are real.
WORKERS_ENABLED=true
# The sweeps (purge, cleanup_pending, housekeeping, orphan objects). On everywhere by default and
# independent of the job loop: without them nothing is purged and remove-all never reaches 200.
SWEEPS_ENABLED=true
# Ingestion jobs one instance runs at once (1 to 16); it claims no more than this per round.
INGESTION_CONCURRENCY=2
# A claimed job is safe from other instances for the lease (ms) and renews it every heartbeat (ms,
# at most a third of the lease). One call to the object store, the embedder or the vector store may
# take INGESTION_IO_TIMEOUT_MS (at most half the lease); parser and OCR calls take the parse timeout.
INGESTION_LEASE_MS=90000
INGESTION_HEARTBEAT_MS=15000
INGESTION_IO_TIMEOUT_MS=30000
# The longest the embedder or the vector store may take for one search (each), in ms; past it the search is a 504.
SEARCH_STEP_TIMEOUT_MS=1500
INGESTION_PARSE_TIMEOUT_MS=180000
# Every document parses in its own worker thread, ended at 90% of the parse timeout. The worker is
# also ended when the process's resident memory grows by this many bytes during the parse (128 MiB
# to 8 GiB). Parses of INGESTION_CONCURRENCY documents share the process, so size it for all of them.
PARSER_MEMORY_LIMIT_BYTES=1073741824
# Claims of one job before the service fails it (1 to 19; the database stops at 20), the first retry
# delay (doubles, full jitter, at most ten minutes) and the idle sleep of the job loop (ms).
INGESTION_MAX_ATTEMPTS=8
INGESTION_RETRY_BASE_MS=5000
INGESTION_POLL_INTERVAL_MS=5000
# A transcribe job asks the vendor for its result this often (ms, jittered) and gives up after the
# maximum wait (ms): the Call then fails with transcription_timed_out.
# TRANSCRIBE_POLL_INTERVAL_MS=5000
# TRANSCRIBE_MAX_WAIT_MS=3600000
# Chunks, in characters: cut towards the target, never above the maximum, overlap between the pieces
# of one long section. Limits per document: chunks and text characters; beyond them it fails.
CHUNK_TARGET_CHARS=1000
CHUNK_MAX_CHARS=1600
CHUNK_OVERLAP_CHARS=150
MAX_CHUNKS_PER_DOCUMENT=5000
MAX_TEXT_CHARS_PER_DOCUMENT=5000000
# Sweeps: Organizations per discovery page, documents per Organization per pass, rows per purge
# statement (each at most 500), the intervals (ms, jittered), the purge lease and the orphan sweep
# (objects with no document are deleted only when older than 24 hours, the database's rule; no setting).
DISCOVERY_BATCH=100
SWEEP_BATCH=20
HOUSEKEEPING_BATCH=200
SWEEP_INTERVAL_MS=30000
HOUSEKEEPING_INTERVAL_MS=600000
PURGE_LEASE_MS=120000
ORPHAN_PAGE_SIZE=200
ORPHAN_MAX_PAGES=25
# How long shutdown lets jobs and sweeps reach a step boundary, in ms. At most SHUTDOWN_TIMEOUT_MS.
WORKERS_STOP_DEADLINE_MS=5000
