{
  "openapi": "3.1.0",
  "info": {
    "title": "tula-closeline-playbook",
    "version": "0.0.0"
  },
  "components": {
    "securitySchemes": {
      "accessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "An access token issued by the auth service."
      }
    },
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": ["health"],
        "summary": "Liveness",
        "description": "Returns 200 while the process is up. It checks no dependency.",
        "responses": {
          "200": {
            "description": "The process is up.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok"]
                    },
                    "service": {
                      "type": "string"
                    },
                    "libraries": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": ["status", "service", "libraries"]
                }
              }
            }
          },
          "500": {
            "description": "Something went wrong on our side.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "maxLength": 100,
                          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
                        },
                        "message": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        },
                        "details": {
                          "type": "object",
                          "additionalProperties": {}
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": ["health"],
        "summary": "Readiness",
        "description": "Runs every dependency check, each with a short timeout; 503 when any fails.",
        "responses": {
          "200": {
            "description": "Every check passed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ready", "unavailable"]
                    },
                    "checks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": ["ok", "failed", "timeout"]
                          }
                        },
                        "required": ["name", "status"]
                      }
                    }
                  },
                  "required": ["status", "checks"]
                }
              }
            }
          },
          "500": {
            "description": "Something went wrong on our side.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "maxLength": 100,
                          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
                        },
                        "message": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        },
                        "details": {
                          "type": "object",
                          "additionalProperties": {}
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "503": {
            "description": "At least one check failed or timed out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ready", "unavailable"]
                    },
                    "checks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": ["ok", "failed", "timeout"]
                          }
                        },
                        "required": ["name", "status"]
                      }
                    }
                  },
                  "required": ["status", "checks"]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
